upstream api_upstream {
    server ${API_UPSTREAM_HOST} max_fails=3 fail_timeout=10s;
    keepalive 32;
}

limit_req_zone $binary_remote_addr zone=api_per_ip:10m rate=${RATE_LIMIT_RPS}r/s;
limit_req_status 429;
limit_conn_zone $binary_remote_addr zone=conn_per_ip:10m;

log_format api_json escape=json '{"time":"$time_iso8601","request_id":"$request_id","remote_addr":"$remote_addr","method":"$request_method","uri":"$request_uri","status":$status,"bytes":$body_bytes_sent,"request_time":$request_time,"upstream_time":"$upstream_response_time","user_agent":"$http_user_agent"}';

server {
    listen 8080 default_server;
    listen [::]:8080 default_server;
    server_name ${SERVER_NAME};

    server_tokens off;
    access_log /dev/stdout api_json;

    client_max_body_size ${CLIENT_MAX_BODY_SIZE};
    client_body_timeout 15s;
    client_header_timeout 15s;
    keepalive_timeout 65s;
    send_timeout 30s;

    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types application/json text/plain application/javascript text/css;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    location = /api/health {
        access_log off;
        include /etc/nginx/snippets/proxy-api.conf;
    }

    location /api/ {
        limit_req zone=api_per_ip burst=${RATE_LIMIT_BURST} nodelay;
        limit_conn conn_per_ip 50;
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/proxy-api.conf;
    }

    location / {
        return 404;
    }
}
